from pyspark.sql import SparkSession
from pyspark.sql.functions import col, count, sum as _sum

# Inicializar Sesión Spark
spark = SparkSession.builder \
    .appName("DataSalud_BigData_Analysis") \
    .getOrCreate()

# Cargar Dataset Regional
df_spark = spark.read.csv("DAT_PlaniFamiliar_01.csv", header=True, inferSchema=True)

# Registro como Vista Temporal para SparkSQL
df_spark.createOrReplaceTempView("atenciones_minsa")

# Consulta distribuida: Conteo de atenciones y suma de insumos por provincia
resultado = spark.sql("""
    SELECT 
        Provincia,
        COUNT(*) AS TotalAtenciones,
        SUM(CAST(CantidadInsumo AS INT)) AS TotalInsumos
    FROM atenciones_minsa
    GROUP BY Provincia
    ORDER BY TotalAtenciones DESC
""")

resultado.show(10)
